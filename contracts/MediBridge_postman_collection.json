            }
          }
        },
        {
          "name": "Get task by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}"
              ]
            },
            "description": "Preencha {{task_id}} com um ID retornado por 'Get all tasks' (nao ha task seedada conhecida)."
          }
        },
        {
          "name": "Update task status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}",
                "status"
              ]
            },
            "description": "Valor de 'status' nao tem enum confirmado no codigo revisado - validar valores aceitos rodando este teste com string invalida tambem (ver plano de QA)."
          }
        }
      ]
    },
    {
      "name": "Internal AI (Lambda -> Backend)",
      "item": [
        {
          "name": "Create or update AI analysis (internal)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{internal_api_key}}",
                "description": "AI_INTERNAL_API_KEY - pegar com a Ayesha/Secrets Manager, NAO e o Bearer token de usuario"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_id\": \"{{doc_delivered_id}}\",\n  \"document_type\": \"lab_result\",\n  \"summary\": \"Test AI summary generated by QA\",\n  \"tags\": [\"routine\"],\n  \"urgency_detected\": false,\n  \"confidence_score\": 0.95,\n  \"processing_time_ms\": 1200,\n  \"model_used\": \"claude-haiku-4-5\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/ai/analyses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "internal",
                "ai",
                "analyses"
              ]
            },
            "description": "Endpoint interno usado pelo Lambda da Ayesha. Usa header x-api-key, NAO Bearer JWT - por isso o auth deste request esta setado como 'noauth' pra sobrescrever o Bearer herdado da collection."
          }
        },
        {
          "name": "Internal AI - missing x-api-key (expect 401/422)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_id\": \"{{doc_delivered_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/ai/analyses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "internal",
                "ai",
                "analyses"
              ]
            },
            "description": "Caso negativo: sem header x-api-key. Esperado 401 ou 422 (FastAPI Header obrigatorio)."
          }
        }
      ]
    },
