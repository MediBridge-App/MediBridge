      "item": [
        {
          "name": "Get API keys",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/settings/api-keys",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "settings",
                "api-keys"
              ]
            }
          }
        },
        {
          "name": "Create API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Test Key\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/settings/api-keys",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "settings",
                "api-keys"
              ]
            },
            "description": "Copie o campo 'key' da resposta (so aparece uma vez) e salve na variavel {{api_key_id}} usando o 'id' retornado, para o request de delete abaixo."
          }
        },
        {
          "name": "Delete API key",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/settings/api-keys/{{api_key_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "settings",
                "api-keys",
                "{{api_key_id}}"
              ]
            }
          }
        }
      ]
    },
