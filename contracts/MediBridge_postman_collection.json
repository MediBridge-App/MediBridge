        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "const idToken =",
                  "    response.id_token ||",
                  "    response.data?.id_token;",
                  "",
                  "pm.test(\"ID token was returned\", function () {",
                  "    pm.expect(idToken, \"id_token not found in response\").to.be.a(\"string\");",
                  "    pm.expect(idToken.length).to.be.greaterThan(10);",
                  "});",
                  "",
                  "if (idToken) {",
                  "    pm.environment.set(\"id_token\", idToken);",
                  "    console.log(\"ID token saved to environment.\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
