        {
          "name": "Create or update AI analysis (internal)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{internal_api_key}}",
                "description": "AI_INTERNAL_API_KEY - get this from Ayesha or Secrets Manager, NOT the user's Bearer token"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_id\": \"{{doc_delivered_id}}\",\n  \"document_type\": \"lab_result\",\n  \"summary\": \"Test AI summary generated by QA\",\n  \"tags\": [\"routine\"],\n  \"urgency_detected\": false,\n  \"confidence_score\": 0.95,\n  \"processing_time_ms\": 1200,\n  \"model_used\": \"claude-haiku-4-5\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/ai/analyses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "internal",
                "ai",
                "analyses"
              ]
            },
            "description": "Internal endpoint used by Ayesha's Lambda. Uses the x-api-key header, NOT a Bearer JWT - that's why auth on this request is set to 'noauth', to override the Bearer inherited from the collection. Note: a successful call also sets the target document's status to 'classified' as a side effect."
          },
