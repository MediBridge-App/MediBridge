        {
          "name": "Internal — Create/update AI analysis",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/internal/ai/analyses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "internal",
                "ai",
                "analyses"
              ]
            },
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{internal_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_id\": \"{{doc_uploaded_id}}\",\n  \"document_type\": \"lab_result\",\n  \"summary\": \"Lipid panel showing elevated LDL and triglycerides.\",\n  \"tags\": [\n    \"lab\",\n    \"lipid_panel\",\n    \"abnormal\"\n  ],\n  \"recommendation_text\": \"Review abnormal lab results with patient.\",\n  \"recommendation_type\": \"review_results\",\n  \"urgency_detected\": true,\n  \"confidence_score\": 94.1,\n  \"processing_time_ms\": 765,\n  \"model_used\": \"claude-haiku-4-5\",\n  \"status\": \"complete\"\n}"
            },
            "description": "Called by Ayesha's Lambda worker after Textract/Bedrock processing. Uses X-API-Key auth (AI_INTERNAL_API_KEY), not the collection's bearer token — set the internal_api_key variable before running this.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
